# --- Razorpay -----------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys, with the mode toggle on Test.
# The executor refuses to run unless the key id starts with rzp_test_, so a
# live key fails loudly instead of quietly moving real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# "mock" (default) simulates every recovery locally and never leaves the
# process. "razorpay_test" calls the real sandbox API.
EXECUTOR_MODE=mock

# Set when you create the webhook in the Razorpay dashboard. This is NOT
# RAZORPAY_KEY_SECRET — a different value signs webhook bodies. Left empty,
# the webhook endpoint refuses every request rather than trusting unsigned
# input.
RAZORPAY_WEBHOOK_SECRET=

# --- Reasoning model ----------------------------------------------------
# Without a key every recommendation falls back to the deterministic path:
# the pipeline still works, but the A/B has nothing to compare.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# How sure the advisor must be before its action choice beats the policy
# default. Raising this toward 1.0 approaches pure deterministic policy.
MODEL_ACTION_CHOICE_MIN_CONFIDENCE=0.7

# --- Service ------------------------------------------------------------
DATABASE_URL=sqlite:///./recovery.db

# Paise. Anything above this is escalated for manual handling and is never
# retried automatically.
AUTO_RECOVERY_AMOUNT_LIMIT=500000

# Comma-separated, exact origins including scheme, no trailing slash.
# 4173 is the port the Playwright suite serves on.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Dashboard routes require a matching X-API-Key. An empty key refuses access.
# For local development ONLY, explicitly set both values below:
# ENVIRONMENT=development
# ALLOW_UNAUTHENTICATED_DEVELOPMENT=true
API_SECRET_KEY=

ENVIRONMENT=development
ALLOW_UNAUTHENTICATED_DEVELOPMENT=false
